{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data, balance, rewards, and preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Full display name of user"
        },
        "username": {
          "type": "string",
          "maxLength": 50,
          "description": "Unique username handle"
        },
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "Email address of user"
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "User bio or tagline"
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 2000,
          "description": "URL or base64 profile picture"
        },
        "joinedDate": {
          "type": "string",
          "description": "Joined date string"
        },
        "level": {
          "type": "number",
          "description": "Current player level"
        },
        "xp": {
          "type": "number",
          "description": "Current XP"
        },
        "nextLevelXp": {
          "type": "number",
          "description": "XP required for next level"
        },
        "balance": {
          "type": "number",
          "description": "Coins balance"
        },
        "gems": {
          "type": "number",
          "description": "Gems balance"
        },
        "streakDays": {
          "type": "number",
          "description": "Daily login streak count"
        },
        "lastClaimedDate": {
          "type": "string",
          "description": "Last claimed date string (YYYY-MM-DD)"
        },
        "language": {
          "type": "string",
          "enum": ["bn", "en"],
          "description": "Selected interface language"
        },
        "soundEnabled": {
          "type": "boolean",
          "description": "Sound effects preference"
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Notifications preference"
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark", "system"],
          "description": "Theme preference"
        },
        "promotedUrl": {
          "type": "string",
          "maxLength": 2000,
          "description": "Custom URL/website set by user for traffic exchange"
        },
        "promotedUrlTitle": {
          "type": "string",
          "maxLength": 100,
          "description": "Title/label for the custom promoted link"
        },
        "promotedUrlActive": {
          "type": "boolean",
          "description": "Whether the promoted URL is active for visits"
        }
      },
      "required": ["userId", "name", "email", "balance", "gems", "level"]
    },
    "PromotedLink": {
      "title": "PromotedLink",
      "description": "Community links shared by users where viewers earn 1 coin after 15s visit and owner pays 1 coin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique link ID, usually user UID"
        },
        "userId": {
          "type": "string",
          "description": "User ID of the owner"
        },
        "userName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of link owner"
        },
        "userAvatar": {
          "type": "string",
          "maxLength": 2000,
          "description": "Avatar of link owner"
        },
        "url": {
          "type": "string",
          "maxLength": 2000,
          "description": "Website or promotional URL"
        },
        "title": {
          "type": "string",
          "maxLength": 100,
          "description": "Title of the website/link"
        },
        "coinsAvailable": {
          "type": "number",
          "description": "Available coins remaining for visits"
        },
        "visitReward": {
          "type": "number",
          "description": "Coins rewarded per 15s visit (default 1)"
        },
        "durationSeconds": {
          "type": "number",
          "description": "Duration required in seconds (default 15)"
        },
        "active": {
          "type": "boolean",
          "description": "Whether link is actively accepting visits"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp string of last update"
        }
      },
      "required": ["id", "userId", "url", "title", "active"]
    },
    "UserTask": {
      "title": "UserTask",
      "description": "Earn tasks and their completion state for a user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Task identifier"
        },
        "title": {
          "type": "string",
          "maxLength": 120,
          "description": "English title of task"
        },
        "titleBn": {
          "type": "string",
          "maxLength": 150,
          "description": "Bengali title of task"
        },
        "reward": {
          "type": "number",
          "description": "Reward coins/gems amount"
        },
        "rewardType": {
          "type": "string",
          "enum": ["coins", "gems"],
          "description": "Reward currency type"
        },
        "category": {
          "type": "string",
          "description": "Category of task"
        },
        "completed": {
          "type": "boolean",
          "description": "Whether task is completed"
        }
      },
      "required": ["id", "title", "reward", "rewardType", "completed"]
    },
    "UserActivity": {
      "title": "UserActivity",
      "description": "History of transactions and reward earnings",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Activity record ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "title": {
          "type": "string",
          "maxLength": 150,
          "description": "Activity title"
        },
        "titleBn": {
          "type": "string",
          "maxLength": 200,
          "description": "Bengali activity title"
        },
        "amount": {
          "type": "number",
          "description": "Amount credited or debited"
        },
        "type": {
          "type": "string",
          "enum": ["coins", "gems"],
          "description": "Currency type"
        },
        "category": {
          "type": "string",
          "description": "Category of activity"
        },
        "timestamp": {
          "type": "string",
          "description": "Display timestamp string"
        }
      },
      "required": ["id", "userId", "title", "amount", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores user profile, coin balance, gems, streak and settings"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/UserTask"
      },
      "description": "Stores user task state"
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": {
        "$ref": "#/entities/UserActivity"
      },
      "description": "Stores user activity history"
    },
    "/promoted_links/{linkId}": {
      "schema": {
        "$ref": "#/entities/PromotedLink"
      },
      "description": "Stores community promoted links for 15s visit traffic exchange"
    }
  }
}
