ild/@esbuild/openbsd-arm64\\\": [\\\"@esbuild/openbsd-arm64@0.28.2\\\", \\\"\\\", { \\\"os\\\": \\\"openbsd\\\", \\\"cpu\\\": \\\"arm64\\\" }, \\\"sha512-AL2qJILH7lNjrDmCQDvdxMfAUIv8KMNZOvrwAQ8i8//ntL9FflhOyMJ8OZSMBb8/AWXe3/5v5S20y3zCoZWKoQ==\\\"],\\n\\n    \\\"tsx/esbuild/@esbuild/openbsd-x64\\\": [\\\"@esbuild/openbsd-x64@0.28.2\\\", \\\"\\\", { \\\"os\\\": \\\"openbsd\\\", \\\"cpu\\\": \\\"x64\\\" }, \\\"sha512-QtiuPytchRyC4rwUKhexJdQKvDuZ6hWloi3igqPQNUJCS1/v9EiO3UTOXR6A3FoMo4fnAKbWJdqaIwhOzh8qEw==\\\"],\\n\\n    \\\"tsx/esbuild/@esbuild/openharmony-arm64\\\": [\\\"@esbuild/openharmony-arm64@0.28.2\\\", \\\"\\\", { \\\"os\\\": \\\"none\\\", \\\"cpu\\\": \\\"arm64\\\" }, \\\"sha512-WkhYDmpTjLvGlScA1rwjRUmhl4k8oXR3cIbtqWmELgU/dFeHHlEllxDvdWcNJV9rbzCexB5vz8gtNewWLgCT7Q==\\\"],\\n\\n    \\\"tsx/esbuild/@esbuild/sunos-x64\\\": [\\\"@esbuild/sunos-x64@0.28.2\\\", \\\"\\\", { \\\"os\\\": \\\"sunos\\\", \\\"cpu\\\": \\\"x64\\\" }, \\\"sha512-GPMSkTOtMnv2U2F8gxe4Io6qmVs+YKyp832Etqqxr0hFngmXQ3rzwytelm3GIn7T4VviRUlf3sOgBOiTdvaf7g==\\\"],\\n\\n    \\\"tsx/esbuild/@esbuild/win32-arm64\\\": [\\\"@esbuild/win32-arm64@0.28.2\\\", \\\"\\\", { \\\"os\\\": \\\"win32\\\", \\\"cpu\\\": \\\"arm64\\\" }, \\\"sha512-PIhhEkE9uPBleRBrQEJpUn7MBnibZzbGzYWPmY3x+YoVg/95zbjB4CxPPOQ8l5tYYM4mMaCthF8/1DIfBQQyWQ==\\\"],\\n\\n    \\\"tsx/esbuild/@esbuild/win32-ia32\\\": [\\\"@esbuild/win32-ia32@0.28.2\\\", \\\"\\\", { \\\"os\\\": \\\"win32\\\", \\\"cpu\\\": \\\"ia32\\\" }, \\\"sha512-YmJbfTlvU7Sdn9BB+4PRES4oB6pxgS37MAONj+hBr/cpXS1aBPKXxNnDbu+QCWPj0o9dgyxeq79g6c5P8KeuYA==\\\"],\\n\\n    \\\"tsx/esbuild/@esbuild/win32-x64\\\": [\\\"@esbuild/win32-x64@0.28.2\\\", \\\"\\\", { \\\"os\\\": \\\"win32\\\", \\\"cpu\\\": \\\"x64\\\" }, \\\"sha512-5ebpxr3nWMzrL/rnUI755Jkuee0bHL/Gq0WTF9lvcpv73wAp5eu8MfBUgWK9bhWvZjj7yX8etf/8tI8Ney695g==\\\"],\\n  }\\n}\\n\",\n  \"firebase-applet-config.json\": \"{\\n  \\\"projectId\\\": \\\"go-to-freelance\\\",\\n  \\\"appId\\\": \\\"1:684909198918:web:260927e33dfcd51cf1d447\\\",\\n  \\\"apiKey\\\": \\\"AIzaSyDRhwIB53-bPKeg9eVwf2bi1YdvN1upuuY\\\",\\n  \\\"authDomain\\\": \\\"go-to-freelance.firebaseapp.com\\\",\\n  \\\"firestoreDatabaseId\\\": \\\"ai-studio-profilerewards-a7c79bcd-77d5-4553-81f8-91b84b41e967\\\",\\n  \\\"storageBucket\\\": \\\"go-to-freelance.firebasestorage.app\\\",\\n  \\\"messagingSenderId\\\": \\\"684909198918\\\",\\n  \\\"measurementId\\\": \\\"\\\",\\n  \\\"oAuthClientId\\\": \\\"684909198918-obgbk51ra2gms3jimi1k44bo3bk84veh.apps.googleusercontent.com\\\",\\n  \\\"recaptchaSiteKey\\\": \\\"\\\"\\n}\",\n  \"firebase-blueprint.json\": \"{\\n  \\\"entities\\\": {\\n    \\\"UserProfile\\\": {\\n      \\\"title\\\": \\\"UserProfile\\\",\\n      \\\"description\\\": \\\"User profile data, balance, rewards, and preferences\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"userId\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Firebase Auth UID\\\"\\n        },\\n        \\\"name\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"maxLength\\\": 100,\\n          \\\"description\\\": \\\"Full display name of user\\\"\\n        },\\n        \\\"username\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"maxLength\\\": 50,\\n          \\\"description\\\": \\\"Unique username handle\\\"\\n        },\\n        \\\"email\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"maxLength\\\": 120,\\n          \\\"description\\\": \\\"Email address of user\\\"\\n        },\\n        \\\"bio\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"maxLength\\\": 500,\\n          \\\"description\\\": \\\"User bio or tagline\\\"\\n        },\\n        \\\"avatarUrl\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"maxLength\\\": 2000,\\n          \\\"description\\\": \\\"URL or base64 profile picture\\\"\\n        },\\n        \\\"joinedDate\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Joined date string\\\"\\n        },\\n        \\\"level\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Current player level\\\"\\n        },\\n        \\\"xp\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Current XP\\\"\\n        },\\n        \\\"nextLevelXp\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"XP required for next level\\\"\\n        },\\n        \\\"balance\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Coins balance\\\"\\n        },\\n        \\\"gems\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Gems balance\\\"\\n        },\\n        \\\"streakDays\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Daily login streak count\\\"\\n        },\\n        \\\"lastClaimedDate\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Last claimed date string (YYYY-MM-DD)\\\"\\n        },\\n        \\\"language\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"enum\\\": [\\\"bn\\\", \\\"en\\\"],\\n          \\\"description\\\": \\\"Selected interface language\\\"\\n        },\\n        \\\"soundEnabled\\\": {\\n          \\\"type\\\": \\\"boolean\\\",\\n          \\\"description\\\": \\\"Sound effects preference\\\"\\n        },\\n        \\\"notificationsEnabled\\\": {\\n          \\\"type\\\": \\\"boolean\\\",\\n          \\\"description\\\": \\\"Notifications preference\\\"\\n        },\\n        \\\"theme\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"enum\\\": [\\\"light\\\", \\\"dark\\\", \\\"system\\\"],\\n          \\\"description\\\": \\\"Theme preference\\\"\\n        },\\n        \\\"promotedUrl\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"maxLength\\\": 2000,\\n          \\\"description\\\": \\\"Custom URL/website set by user for traffic exchange\\\"\\n        },\\n        \\\"promotedUrlTitle\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"maxLength\\\": 100,\\n          \\\"description\\\": \\\"Title/label for the custom promoted link\\\"\\n        },\\n        \\\"promotedUrlActive\\\": {\\n          \\\"type\\\": \\\"boolean\\\",\\n          \\\"description\\\": \\\"Whether the promoted URL is active for visits\\\"\\n        }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"name\\\", \\\"email\\\", \\\"balance\\\", \\\"gems\\\", \\\"level\\\"]\\n    },\\n    \\\"PromotedLink\\\": {\\n      \\\"title\\\": \\\"PromotedLink\\\",\\n      \\\"description\\\": \\\"Community links shared by users where viewers earn 1 coin after 15s visit and owner pays 1 coin\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"id\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Unique link ID, usually user UID\\\"\\n        },\\n        \\\"userId\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"User ID of the owner\\\"\\n        },\\n        \\\"userName\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"maxLength\\\": 100,\\n          \\\"description\\\": \\\"Display name of link owner\\\"\\n        },\\n        \\\"userAvatar\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"maxLength\\\": 2000,\\n          \\\"description\\\": \\\"Avatar of link owner\\\"\\n        },\\n        \\\"url\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"maxLength\\\": 2000,\\n          \\\"description\\\": \\\"Website or promotional URL\\\"\\n        },\\n        \\\"title\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"maxLength\\\": 100,\\n          \\\"description\\\": \\\"Title of the website/link\\\"\\n        },\\n        \\\"coinsAvailable\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Available coins remaining for visits\\\"\\n        },\\n        \\\"visitReward\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Coins rewarded per 15s visit (default 1)\\\"\\n        },\\n        \\\"durationSeconds\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Duration required in seconds (default 15)\\\"\\n        },\\n        \\\"active\\\": {\\n          \\\"type\\\": \\\"boolean\\\",\\n          \\\"description\\\": \\\"Whether link is actively accepting visits\\\"\\n        },\\n        \\\"updatedAt\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"ISO timestamp string of last update\\\"\\n        }\\n      },\\n      \\\"required\\\": [\\\"id\\\", \\\"userId\\\", \\\"url\\\", \\\"title\\\", \\\"active\\\"]\\n    },\\n    \\\"UserTask\\\": {\\n      \\\"title\\\": \\\"UserTask\\\",\\n      \\\"description\\\": \\\"Earn tasks and their completion state for a user\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"id\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Task identifier\\\"\\n        },\\n        \\\"title\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"maxLength\\\": 120,\\n          \\\"description\\\": \\\"English title of task\\\"\\n        },\\n        \\\"titleBn\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"maxLength\\\": 150,\\n          \\\"description\\\": \\\"Bengali title of task\\\"\\n        },\\n        \\\"reward\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Reward coins/gems amount\\\"\\n        },\\n        \\\"rewardType\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"enum\\\": [\\\"coins\\\", \\\"gems\\\"],\\n          \\\"description\\\": \\\"Reward currency type\\\"\\n        },\\n        \\\"category\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Category of task\\\"\\n        },\\n        \\\"completed\\\": {\\n          \\\"type\\\": \\\"boolean\\\",\\n          \\\"description\\\": \\\"Whether task is completed\\\"\\n        }\\n      },\\n      \\\"required\\\": [\\\"id\\\", \\\"title\\\", \\\"reward\\\", \\\"rewardType\\\", \\\"completed\\\"]\\n    },\\n    \\\"UserActivity\\\": {\\n      \\\"title\\\": \\\"UserActivity\\\",\\n      \\\"description\\\": \\\"History of transactions and reward earnings\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"id\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Activity record ID\\\"\\n        },\\n        \\\"userId\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Owner user ID\\\"\\n        },\\n        \\\"title\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"maxLength\\\": 150,\\n          \\\"description\\\": \\\"Activity title\\\"\\n        },\\n        \\\"titleBn\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"maxLength\\\": 200,\\n          \\\"description\\\": \\\"Bengali activity title\\\"\\n        },\\n        \\\"amount\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Amount credited or debited\\\"\\n        },\\n        \\\"type\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"enum\\\": [\\\"coins\\\", \\\"gems\\\"],\\n          \\\"description\\\": \\\"Currency type\\\"\\n        },\\n        \\\"category\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Category of activity\\\"\\n        },\\n        \\\"timestamp\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Display timestamp string\\\"\\n        }\\n      },\\n      \\\"required\\\": [\\\"id\\\", \\\"userId\\\", \\\"title\\\", \\\"amount\\\", \\\"type\\\"]\\n    }\\n  },\\n  \\\"firestore\\\": {\\n    \\\"/users/{userId}\\\": {\\n      \\\"schema\\\": {\\n        \\\"$ref\\\": \\\"#/entities/UserProfile\\\"\\n      },\\n      \\\"description\\\": \\\"Stores user profile, coin balance, gems, streak and settings\\\"\\n    },\\n    \\\"/users/{userId}/tasks/{taskId}\\\": {\\n      \\\"schema\\\": {\\n        \\\"$ref\\\": \\\"#/entities/UserTask\\\"\\n      },\\n      \\\"description\\\": \\\"Stores user task state\\\"\\n    },\\n    \\\"/users/{userId}/activities/{activityId}\\\": {\\n      \\\"schema\\\": {\\n        \\\"$ref\\\": \\\"#/entities/UserActivity\\\"\\n      },\\n      \\\"description\\\": \\\"Stores user activity history\\\"\\n    },\\n    \\\"/promoted_links/{linkId}\\\": {\\n      \\\"schema\\\": {\\n        \\\"$ref\\\": \\\"#/entities/PromotedLink\\\"\\n      },\\n      \\\"description\\\": \\\"Stores community promoted links for 15s visit traffic exchange\\\"\\n    }\\n  }\\n}\\n\",\n  \"firestore.rules\": \"rules_version = '2';\\nservice cloud.firestore {\\n  match /databases/{database}/documents {\\n\\n    // Default deny catch-all\\n    match /{document=**} {\\n      allow read, write: if false;\\n    }\\n\\n    // Helper functions\\n    function isSignedIn() {\\n      return request.auth != null;\\n    }\\n\\n    function isOwner(userId) {\\n      return isSignedIn() && request.auth.uid == userId;\\n    }\\n\\n    function isValidId(id) {\\n      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\\\\\-]+$');\\n    }\\n\\n    function isValidUserProfile(data) {\\n      return data.name is string && data.name.size() <= 100 &&\\n             data.email is string && data.email.size() <= 120 &&\\n             (!('username' in data) || (data.username is string && data.username.size() <= 50)) &&\\n             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&\\n             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2000)) &&\\n             (!('joinedDate' in data) || (data.joinedDate is string && data.joinedDate.size() <= 50)) &&\\n             (!('level' in data) || data.level is number) &&\\n             (!('xp' in data) || data.xp is number) &&\\n             (!('nextLevelXp' in data) || data.nextLevelXp is number) &&\\n             (!('balance' in data) || data.balance is number) &&\\n             (!('gems' in data) || data.gems is number) &&\\n             (!('streakDays' in data) || data.streakDays is number) &&\\n             (!('lastClaimedDate' in data) || data.lastClaimedDate == null || data.lastClaimedDate is string) &&\\n             (!('language' in data) || (data.language in ['bn', 'en'])) &&\\n             (!('soundEnabled' in data) || data.soundEnabled is bool) &&\\n             (!('notificationsEnabled' in data) || data.notificationsEnabled is bool) &&\\n             (!('theme' in data) || (data.theme in ['light', 'dark', 'system'])) &&\\n             (!('promotedUrl' in data) || data.promotedUrl is string && data.promotedUrl.size() <= 2000) &&\\n             (!('promotedUrlTitle' in data) || data.promotedUrlTitle is string && data.promotedUrlTitle.size() <= 100) &&\\n             (!('promotedUrlActive' in data) || data.promotedUrlActive is bool);\\n    }\\n\\n    function isValidPromotedLink(data) {\\n      return data.id is string && data.id.size() <= 128 &&\\n             data.userId is string && data.userId.size() <= 128 &&\\n             data.url is string && data.url.size() <= 2000 &&\\n             data.title is string && data.title.size() <= 100 &&\\n             data.active is bool &&\\n             (!('coinsAvailable' in data) || data.coinsAvailable is number) &&\\n             (!('visitReward' in data) || data.visitReward is number) &&\\n             (!('durationSeconds' in data) || data.durationSeconds is number);\\n    }\\n\\n    function isValidTask(data) {\\n      return data.id is string && data.id.size() <= 128 &&\\n             data.title is string && data.title.size() <= 120 &&\\n             (!('titleBn' in data) || (data.titleBn is string && data.titleBn.size() <= 150)) &&\\n             data.reward is number &&\\n             data.rewardType in ['coins', 'gems'] &&\\n             data.completed is bool;\\n    }\\n\\n    function isValidActivity(data) {\\n      return data.id is string && data.id.size() <= 128 &&\\n             data.title is string && data.title.size() <= 150 &&\\n             data.amount is number &&\\n             data.type in ['coins', 'gems'];\\n    }\\n\\n    // User Profile\\n    match /users/{userId} {\\n      allow get: if isOwner(userId);\\n      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);\\n      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);\\n      allow delete: if isOwner(userId);\\n\\n      // Subcollection: Tasks\\n      match /tasks/{taskId} {\\n        allow read: if isOwner(userId);\\n        allow write: if isOwner(userId) && isValidTask(request.resource.data);\\n      }\\n\\n      // Subcollection: Activities\\n      match /activities/{activityId} {\\n        allow read: if isOwner(userId);\\n        allow create: if isOwner(userId) && isValidActivity(request.resource.data);\\n        allow update, delete: if isOwner(userId);\\n      }\\n    }\\n\\n    // Community Promoted Links for Traffic Exchange\\n    match /promoted_links/{linkId} {\\n      allow read: if true;\\n      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId && isValidPromotedLink(request.resource.data);\\n      allow update: if isSignedIn() && (\\n        (request.auth.uid == resource.data.userId && isValidPromotedLink(request.resource.data)) ||\\n        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coinsAvailable', 'active', 'updatedAt']))\\n      );\\n      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;\\n    }\\n\\n    // Test connection document\\n    match /test/co