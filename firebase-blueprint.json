{
  "entities": {
    "RemoteSession": {
      "title": "Remote Session",
      "description": "Pairing session linking a remote controller to the main display screen",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "6-character pairing code"
        },
        "userId": {
          "type": "string",
          "description": "Google Auth UID of the remote operator"
        },
        "userEmail": {
          "type": "string",
          "description": "Google Auth email"
        },
        "userDisplayName": {
          "type": "string",
          "description": "Google Auth display name"
        },
        "userPhoto": {
          "type": "string",
          "description": "Google Auth avatar URL"
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "active", "disconnected"]
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp ms when created"
        },
        "lastActive": {
          "type": "number",
          "description": "Timestamp ms when last active"
        },
        "lastMessage": {
          "type": "object",
          "description": "Latest remote action payload"
        }
      },
      "required": ["code", "userId", "status", "createdAt"]
    }
  },
  "firestore": {
    "/remote_sessions/{code}": {
      "schema": "RemoteSession",
      "description": "Active remote pairing sessions keyed by pairing code"
    }
  }
}
